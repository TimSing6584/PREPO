{
  "name": "prepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/dev-with-infisical.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:studio": "infisical run --env=dev -- prisma studio",
    "db:migrate_dev": "infisical run --env=dev -- prisma migrate dev",
    "db:migrate_deploy": "infisical run --env=dev -- prisma migrate deploy",
    "db:reset": "infisical run --env=dev -- prisma migrate reset",
    "db:migrate_schema_check": "infisical run --env=dev -- prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@kinde-oss/kinde-auth-nextjs": "^2.11.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "pg": "^8.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
